# ---- app ----
ENVIRONMENT=dev
CORSI_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3080
DEFAULT_TENANT=default

# ---- postgres ----
DATABASE_URL=postgresql+asyncpg://lms:lms@127.0.0.1:5432/lms

# ---- redis (arq queues) ----
REDIS_URL=redis://127.0.0.1:6381/0
# inline = FastAPI background task; arq = separate worker process
TASK_BACKEND=inline

# ---- object storage: minio | local ----
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./.data/objects
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lms-docs
MINIO_SECURE=false

# ---- vector store: memory | milvus ----
# memory is process-local (data is lost on restart, re-ingest documents)
VECTOR_BACKEND=memory
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=lms_chunks_v1

# ---- knowledge graph (P1) ----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lmsneo4j

# ---- model gateways (OpenAI-compatible: vLLM / TEI) ----
# Leave LLM_BASE_URL empty to run the deterministic MockLLM (offline demo + tests).
LLM_BASE_URL=
LLM_API_KEY=EMPTY
LLM_MODEL=qwen2.5-32b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
LLM_FORCE_MOCK=false

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Optional reranker (TEI /v1/rerank or vLLM /rerank); leave empty to skip.
RERANK_BASE_URL=
RERANK_API_KEY=EMPTY
RERANK_MODEL=bge-reranker-v2-m3

# ---- ingestion ----
CHUNK_SIZE=600
CHUNK_OVERLAP=80
UPLOAD_MAX_MB=100

# ---- retrieval ----
RETRIEVAL_TOP_K=20
RETRIEVAL_BM25_K=30
RERANK_TOP_K=8
MAX_CONTEXT_CHARS=12000
MAX_RETRIEVAL_ROUNDS=2
SUFFICIENCY_THRESHOLD=0.35